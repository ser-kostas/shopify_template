<section class="image-with-text section">

  <div class="page-width">

    <div
      class="
        image-with-text__grid
        image-with-text__grid--{{ section.settings.image_position }}
      "
    >

      <div class="image-with-text__media">

        {% if section.settings.image != blank %}

          {{
            section.settings.image
            | image_url: width: 1400
            | image_tag:
              loading: 'lazy',
              widths: '500, 800, 1100, 1400',
              sizes: '(min-width: 990px) 50vw, 100vw',
              class: 'image-with-text__image',
              alt: section.settings.image.alt
          }}

        {% else %}

          <div class="image-with-text__placeholder">
            {{ 'image' | placeholder_svg_tag }}
          </div>

        {% endif %}

      </div>


      <div class="image-with-text__content">

        {% if section.settings.eyebrow != blank %}
          <p class="image-with-text__eyebrow">
            {{ section.settings.eyebrow }}
          </p>
        {% endif %}


        {% if section.settings.heading != blank %}
          <h2 class="heading-lg">
            {{ section.settings.heading }}
          </h2>
        {% endif %}


        {% if section.settings.text != blank %}
          <div class="image-with-text__text">
            {{ section.settings.text }}
          </div>
        {% endif %}


        {% if section.settings.button_label != blank %}

          <a
            href="{{ section.settings.button_link | default: routes.all_products_collection_url }}"
            class="button"
          >
            {{ section.settings.button_label }}
          </a>

        {% endif %}

      </div>

    </div>

  </div>

</section>


{% stylesheet %}

  .image-with-text__grid {
    display: grid;

    grid-template-columns:
      minmax(0, 1fr)
      minmax(0, 1fr);

    align-items: center;

    gap: 5rem;
  }

  .image-with-text__grid--right .image-with-text__media {
    order: 2;
  }

  .image-with-text__grid--right .image-with-text__content {
    order: 1;
  }


  /* Media */

  .image-with-text__media {
    overflow: hidden;

    aspect-ratio: 1 / 1;

    background: var(--color-surface);
  }

  .image-with-text__image,
  .image-with-text__placeholder {
    width: 100%;
    height: 100%;

    object-fit: cover;
  }

  .image-with-text__placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
  }


  /* Content */

  .image-with-text__content {
    max-width: 560px;
  }

  .image-with-text__eyebrow {
    margin-bottom: 0.75rem;

    color: var(--color-text-muted);

    font-size: 0.8rem;
    font-weight: 600;

    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .image-with-text__content .heading-lg {
    margin-bottom: 1.5rem;
  }

  .image-with-text__text {
    margin-bottom: 2rem;

    color: var(--color-text-muted);

    font-size: 1.05rem;
  }


  @media screen and (max-width: 990px) {

    .image-with-text__grid {
      gap: 3rem;
    }

  }


  @media screen and (max-width: 749px) {

    .image-with-text__grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .image-with-text__grid--right .image-with-text__media {
      order: 1;
    }

    .image-with-text__grid--right .image-with-text__content {
      order: 2;
    }

  }

{% endstylesheet %}


{% schema %}
{
  "name": "Image with text",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Our story"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Made for everyday life"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Tell your customers what makes your brand different. Share your story, your values, or what inspired your products.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Learn more"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    }
  ],
  "presets": [
    {
      "name": "Image with text"
    }
  ]
}
{% endschema %}