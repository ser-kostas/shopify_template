<section class="related-products section">

  <div class="page-width">

    <div class="related-products__header">

      <h2 class="heading-lg">
        You may also like
      </h2>

    </div>


    {% if product.collections.first != blank %}

      {% assign related_collection = product.collections.first %}

      {% assign related_count = 0 %}

      <div class="product-grid">

        {% for related_product in related_collection.products %}

          {% if related_product.id != product.id %}

            {% render 'product-card',
              product: related_product,
              show_vendor: false
            %}

            {% assign related_count = related_count | plus: 1 %}

            {% if related_count >= section.settings.products_to_show %}
              {% break %}
            {% endif %}

          {% endif %}

        {% endfor %}

      </div>

    {% endif %}

  </div>

</section>


{% stylesheet %}

  .related-products {
    border-top: 1px solid var(--color-border);
  }

  .related-products__header {
    margin-bottom: 2.5rem;
  }

  .related-products__header .heading-lg {
    margin-bottom: 0;
  }


  @media screen and (max-width: 749px) {

    .related-products .product-grid {
      gap: 1rem;
    }

  }

{% endstylesheet %}


{% schema %}
{
  "name": "Related products",
  "settings": [
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    }
  ],
  "presets": [
    {
      "name": "Related products"
    }
  ]
}
{% endschema %}