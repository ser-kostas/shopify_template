<section class="main-product section">

  <div class="page-width">

    <div class="main-product__grid">

      <div class="main-product__media">

        {% if product.featured_image != blank %}

          {{
            product.featured_image
            | image_url: width: 1600
            | image_tag:
              loading: 'eager',
              widths: '600, 900, 1200, 1600',
              sizes: '(min-width: 990px) 50vw, 100vw',
              class: 'main-product__image',
              alt: product.featured_image.alt
          }}

        {% else %}

          <div class="main-product__placeholder">
            {{ 'product-1' | placeholder_svg_tag }}
          </div>

        {% endif %}


        {% if product.images.size > 1 %}

          <div class="main-product__thumbnails">

            {% for image in product.images %}

              <a
                href="{{ image | image_url: width: 1600 }}"
                class="main-product__thumbnail"
              >

                {{
                  image
                  | image_url: width: 300
                  | image_tag:
                    loading: 'lazy',
                    widths: '100, 200, 300',
                    sizes: '100px',
                    alt: image.alt
                }}

              </a>

            {% endfor %}

          </div>

        {% endif %}

      </div>


      <div class="main-product__details">

        {% if product.vendor != blank %}

          <p class="main-product__vendor">
            {{ product.vendor }}
          </p>

        {% endif %}


        <h1 class="main-product__title">
          {{ product.title }}
        </h1>


        <div class="main-product__price">
          {% render 'price', product: product %}
        </div>


        {% if product.description != blank %}

          <div class="main-product__description">
            {{ product.description }}
          </div>

        {% endif %}


        {% form 'product',
          product,
          class: 'main-product__form'
        %}

          {% unless product.has_only_default_variant %}

            <div class="main-product__options">

              {% for option in product.options_with_values %}

                <fieldset class="main-product__option">

                  <legend class="main-product__option-label">
                    {{ option.name }}
                  </legend>


                  <div class="main-product__option-values">

                    {% for value in option.values %}

                      <label class="main-product__option-value">

                        <input
                          type="radio"
                          name="options[{{ option.name | escape }}]"
                          value="{{ value | escape }}"
                          {% if option.selected_value == value %}
                            checked
                          {% endif %}
                        >

                        <span>
                          {{ value }}
                        </span>

                      </label>

                    {% endfor %}

                  </div>

                </fieldset>

              {% endfor %}

            </div>

          {% endunless %}


          <div class="main-product__quantity">

            <label
              for="Quantity-{{ section.id }}"
              class="main-product__quantity-label"
            >
              Quantity
            </label>

            <div
              class="main-product__quantity-selector"
              data-quantity-selector
            >

              <button
                type="button"
                data-quantity-decrease
                aria-label="Decrease quantity"
              >
                −
              </button>

              <input
                id="Quantity-{{ section.id }}"
                type="number"
                name="quantity"
                value="1"
                min="1"
                data-quantity-input
              >

              <button
                type="button"
                data-quantity-increase
                aria-label="Increase quantity"
              >
                +
              </button>

            </div>

          </div>


          <input
            type="hidden"
            name="id"
            value="{{ product.selected_or_first_available_variant.id }}"
          >


          <button
            type="submit"
            name="add"
            class="button main-product__add-button"
            {% unless product.selected_or_first_available_variant.available %}
              disabled
            {% endunless %}
          >

            {% if product.selected_or_first_available_variant.available %}
              Add to cart
            {% else %}
              Sold out
            {% endif %}

          </button>

        {% endform %}


        {% if product.available %}

          <div class="main-product__availability">
            In stock
          </div>

        {% endif %}

      </div>

    </div>

  </div>

</section>


{% stylesheet %}

  .main-product__grid {
    display: grid;

    grid-template-columns:
      minmax(0, 1.1fr)
      minmax(0, 0.9fr);

    gap: 5rem;

    align-items: start;
  }


  /* -------------------------------------------------------
     Product media
     ------------------------------------------------------- */

  .main-product__media {
    min-width: 0;
  }

  .main-product__image {
    width: 100%;
    height: auto;

    background: var(--color-surface);
  }

  .main-product__placeholder {
    aspect-ratio: 1 / 1;

    display: flex;
    align-items: center;
    justify-content: center;

    background: var(--color-surface);
  }

  .main-product__placeholder svg {
    width: 100%;
    height: 100%;
  }


  /* -------------------------------------------------------
     Thumbnails
     ------------------------------------------------------- */

  .main-product__thumbnails {
    display: grid;

    grid-template-columns:
      repeat(5, minmax(0, 1fr));

    gap: 0.75rem;

    margin-top: 1rem;
  }

  .main-product__thumbnail {
    display: block;

    overflow: hidden;

    aspect-ratio: 1 / 1;

    background: var(--color-surface);
  }

  .main-product__thumbnail img {
    width: 100%;
    height: 100%;

    object-fit: cover;

    transition:
      transform var(--transition-normal);
  }

  .main-product__thumbnail:hover img {
    transform: scale(1.04);
  }


  /* -------------------------------------------------------
     Product details
     ------------------------------------------------------- */

  .main-product__details {
    position: sticky;
    top: 2rem;
  }

  .main-product__vendor {
    margin-bottom: 0.75rem;

    color: var(--color-text-muted);

    font-size: 0.8rem;
    font-weight: 600;

    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .main-product__title {
    margin-bottom: 1rem;

    font-size: clamp(
      2rem,
      4vw,
      3rem
    );

    line-height: 1.1;
    letter-spacing: -0.025em;
  }

  .main-product__price {
    margin-bottom: 2rem;
  }

  .main-product__description {
    margin-bottom: 2rem;

    color: var(--color-text-muted);
  }


  /* -------------------------------------------------------
     Product options
     ------------------------------------------------------- */

  .main-product__options {
    margin-bottom: 1.5rem;
  }

  .main-product__option {
    padding: 0;

    margin: 0 0 1.5rem;

    border: 0;
  }

  .main-product__option-label {
    margin-bottom: 0.75rem;

    font-size: 0.875rem;
    font-weight: 600;
  }

  .main-product__option-values {
    display: flex;
    flex-wrap: wrap;

    gap: 0.5rem;
  }

  .main-product__option-value {
    position: relative;

    cursor: pointer;
  }

  .main-product__option-value input {
    position: absolute;

    opacity: 0;
    pointer-events: none;
  }

  .main-product__option-value span {
    display: block;

    padding: 0.65rem 0.9rem;

    border: 1px solid var(--color-border);
    border-radius: var(--button-radius);

    font-size: 0.875rem;
  }

  .main-product__option-value:hover span {
    border-color: var(--color-text);
  }

  .main-product__option-value input:checked + span {
    border-color: var(--color-primary);

    background: var(--color-primary);
    color: var(--color-white);
  }


  /* -------------------------------------------------------
     Quantity
     ------------------------------------------------------- */

  .main-product__quantity {
    margin-bottom: 1.25rem;
  }

  .main-product__quantity-label {
    display: block;

    margin-bottom: 0.5rem;

    font-size: 0.875rem;
    font-weight: 600;
  }

  .main-product__quantity-selector {
    display: inline-flex;
    align-items: center;

    border: 1px solid var(--color-border);
    border-radius: var(--button-radius);
  }

  .main-product__quantity-selector button {
    width: 42px;
    height: 42px;

    border: 0;

    background: transparent;
    color: var(--color-text);

    font-size: 1.25rem;
  }

  .main-product__quantity-selector button:hover {
    background: var(--color-surface);
  }

  .main-product__quantity-selector input {
    width: 50px;
    height: 42px;

    padding: 0;

    border: 0;

    background: transparent;

    text-align: center;

    appearance: textfield;
  }

  .main-product__quantity-selector input::-webkit-inner-spin-button,
  .main-product__quantity-selector input::-webkit-outer-spin-button {
    margin: 0;

    appearance: none;
  }


  /* -------------------------------------------------------
     Add to cart
     ------------------------------------------------------- */

  .main-product__add-button {
    width: 100%;

    margin-top: 0.5rem;
  }

  .main-product__add-button:disabled {
    cursor: not-allowed;

    opacity: 0.5;
  }

  .main-product__availability {
    margin-top: 1rem;

    color: var(--color-text-muted);

    font-size: 0.8125rem;
  }


  /* -------------------------------------------------------
     Responsive
     ------------------------------------------------------- */

  @media screen and (max-width: 990px) {

    .main-product__grid {
      gap: 3rem;
    }

  }


  @media screen and (max-width: 749px) {

    .main-product__grid {
      grid-template-columns: 1fr;

      gap: 2rem;
    }

    .main-product__details {
      position: static;
    }

    .main-product__thumbnails {
      grid-template-columns:
        repeat(4, minmax(0, 1fr));
    }

  }

{% endstylesheet %}


{% schema %}
{
  "name": "Main product",
  "settings": [],
  "presets": [
    {
      "name": "Main product"
    }
  ]
}
{% endschema %}