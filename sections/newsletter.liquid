<section class="newsletter section">

  <div class="page-width">

    <div class="newsletter__inner">

      {% if section.settings.eyebrow != blank %}
        <p class="newsletter__eyebrow">
          {{ section.settings.eyebrow }}
        </p>
      {% endif %}


      {% if section.settings.heading != blank %}
        <h2 class="heading-lg">
          {{ section.settings.heading }}
        </h2>
      {% endif %}


      {% if section.settings.text != blank %}
        <div class="newsletter__text">
          {{ section.settings.text }}
        </div>
      {% endif %}


      {% form 'customer', class: 'newsletter__form' %}

        {% if form.posted_successfully? %}

          <div class="newsletter__message newsletter__message--success">
            {{ section.settings.success_message }}
          </div>

        {% endif %}


        {% if form.errors %}

          <div class="newsletter__message newsletter__message--error">
            {{ form.errors | default_errors }}
          </div>

        {% endif %}


        <div class="newsletter__form-row">

          <label
            class="visually-hidden"
            for="NewsletterEmail-{{ section.id }}"
          >
            Email address
          </label>

          <input
            id="NewsletterEmail-{{ section.id }}"
            type="email"
            name="contact[email]"
            class="newsletter__input"
            value="{{ form.email }}"
            placeholder="Your email address"
            autocomplete="email"
            autocorrect="off"
            autocapitalize="off"
            required
          >

          <input
            type="hidden"
            name="contact[tags]"
            value="newsletter"
          >

          <button
            type="submit"
            class="button newsletter__button"
          >
            {{ section.settings.button_label }}
          </button>

        </div>

      {% endform %}

    </div>

  </div>

</section>


{% stylesheet %}

  .newsletter {
    background: var(--color-surface);
  }

  .newsletter__inner {
    max-width: 700px;

    margin: 0 auto;

    text-align: center;
  }

  .newsletter__eyebrow {
    margin-bottom: 0.75rem;

    color: var(--color-text-muted);

    font-size: 0.8rem;
    font-weight: 600;

    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .newsletter__inner .heading-lg {
    margin-bottom: 1rem;
  }

  .newsletter__text {
    max-width: 560px;

    margin: 0 auto 2rem;

    color: var(--color-text-muted);
  }

  .newsletter__form {
    width: 100%;
  }

  .newsletter__form-row {
    display: flex;

    max-width: 560px;

    margin: 0 auto;
  }

  .newsletter__input {
    flex: 1;

    min-width: 0;
    min-height: 48px;

    padding: 0.75rem 1rem;

    border: 1px solid var(--color-border);
    border-right: 0;

    border-radius: var(--button-radius) 0 0 var(--button-radius);

    background: var(--color-background);
    color: var(--color-text);

    outline: none;
  }

  .newsletter__input:focus {
    border-color: var(--color-primary);
  }

  .newsletter__button {
    flex-shrink: 0;

    width: auto;

    border-radius:
      0
      var(--button-radius)
      var(--button-radius)
      0;
  }

  .newsletter__message {
    margin-bottom: 1.5rem;

    font-size: 0.875rem;
  }

  .newsletter__message--success {
    color: #287a43;
  }

  .newsletter__message--error {
    color: #b42318;
  }


  @media screen and (max-width: 749px) {

    .newsletter__form-row {
      flex-direction: column;
      gap: 0.75rem;
    }

    .newsletter__input {
      border-right: 1px solid var(--color-border);
      border-radius: var(--button-radius);
    }

    .newsletter__button {
      width: 100%;
      border-radius: var(--button-radius);
    }

  }

{% endstylesheet %}


{% schema %}
{
  "name": "Newsletter",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Stay connected"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Stay in the loop"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Sign up for new products, special offers and updates.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Subscribe"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success message",
      "default": "Thanks for subscribing!"
    }
  ],
  "presets": [
    {
      "name": "Newsletter"
    }
  ]
}
{% endschema %}