<header class="site-header">

  <div class="page-width site-header__inner">

    <button
      class="site-header__menu-button"
      type="button"
      data-menu-toggle
      aria-expanded="false"
      aria-controls="MobileMenu"
      aria-label="Open menu"
    >

      {% render 'icon', icon: 'menu' %}

    </button>


    <a
      href="{{ routes.root_url }}"
      class="site-header__logo"
      aria-label="{{ shop.name }}"
    >

      {% if section.settings.logo != blank %}

        {{
          section.settings.logo
          | image_url: width: 400
          | image_tag:
            loading: 'eager',
            widths: '100, 200, 300, 400',
            class: 'site-header__logo-image',
            alt: shop.name
        }}

      {% else %}

        <span class="site-header__logo-text">
          {{ shop.name }}
        </span>

      {% endif %}

    </a>


    <nav
      class="site-header__navigation"
      aria-label="Main navigation"
    >

      {% if section.settings.menu != blank %}

        <ul class="site-header__menu">

          {% for link in section.settings.menu.links %}

            <li class="site-header__menu-item">

              <a
                href="{{ link.url }}"
                class="site-header__menu-link"
                {% if link.current %}
                  aria-current="page"
                {% endif %}
              >
                {{ link.title }}
              </a>

            </li>

          {% endfor %}

        </ul>

      {% endif %}

    </nav>


    <div class="site-header__actions">

      {% if shop.customer_accounts_enabled %}

        <a
          href="{{ routes.account_url }}"
          class="site-header__action"
          aria-label="Account"
        >

          {% render 'icon', icon: 'account' %}

          <span class="site-header__action-label">
            Account
          </span>

        </a>

      {% endif %}


      <a
        href="{{ routes.cart_url }}"
        class="site-header__action"
        aria-label="Cart"
      >

        {% render 'icon', icon: 'cart' %}

        <span class="site-header__action-label">
          Cart
        </span>

        <span class="site-header__cart-count">
          {{ cart.item_count }}
        </span>

      </a>

    </div>

  </div>


  <div
    id="MobileMenu"
    class="site-header__mobile-menu"
    data-mobile-menu
    aria-hidden="true"
  >

    <div class="page-width">

      {% if section.settings.menu != blank %}

        <nav aria-label="Mobile navigation">

          <ul class="site-header__mobile-menu-list">

            {% for link in section.settings.menu.links %}

              <li>

                <a
                  href="{{ link.url }}"
                  class="site-header__mobile-link"
                >
                  {{ link.title }}
                </a>

              </li>

            {% endfor %}

          </ul>

        </nav>

      {% endif %}

    </div>

  </div>

</header>


{% stylesheet %}

  .site-header {
    position: relative;

    width: 100%;

    background: var(--color-background);

    border-bottom:
      1px solid
      var(--color-border);

    z-index: 20;
  }


  .site-header__inner {
    min-height: 76px;

    display: flex;

    align-items: center;
    justify-content: space-between;

    gap: 2rem;
  }


  /* -------------------------------------------------------
     Logo
     ------------------------------------------------------- */

  .site-header__logo {
    flex-shrink: 0;

    font-weight: 700;
    font-size: 1.25rem;
  }


  .site-header__logo-image {
    width: auto;

    max-width: 180px;
    max-height: 50px;

    object-fit: contain;
  }


  .site-header__logo-text {
    white-space: nowrap;
  }


  /* -------------------------------------------------------
     Navigation
     ------------------------------------------------------- */

  .site-header__navigation {
    flex: 1;
  }


  .site-header__menu {
    display: flex;

    justify-content: center;
    align-items: center;

    gap: 2rem;
  }


  .site-header__menu-link {
    position: relative;

    font-size: 0.9375rem;
  }


  .site-header__menu-link::after {
    content: "";

    position: absolute;

    left: 0;
    bottom: -5px;

    width: 0;
    height: 1px;

    background: currentColor;

    transition:
      width var(--transition-normal);
  }


  .site-header__menu-link:hover::after {
    width: 100%;
  }


  /* -------------------------------------------------------
     Header actions
     ------------------------------------------------------- */

  .site-header__actions {
    display: flex;

    align-items: center;

    gap: 1.25rem;

    flex-shrink: 0;
  }


  .site-header__action {
    display: inline-flex;

    align-items: center;

    gap: 0.35rem;

    font-size: 0.875rem;
  }


  .site-header__action svg {
    width: 20px;
    height: 20px;

    flex-shrink: 0;
  }


  .site-header__cart-count {
    display: inline-flex;

    align-items: center;
    justify-content: center;

    min-width: 20px;
    height: 20px;

    margin-left: 2px;

    border-radius: 50%;

    background: var(--color-primary);
    color: var(--color-white);

    font-size: 0.7rem;
  }


  /* -------------------------------------------------------
     Mobile menu button
     ------------------------------------------------------- */

  .site-header__menu-button {
    display: none;

    align-items: center;
    justify-content: center;

    width: 40px;
    height: 40px;

    padding: 8px;

    border: 0;

    background: transparent;
  }


  .site-header__menu-button svg {
    width: 24px;
    height: 24px;
  }


  /* -------------------------------------------------------
     Mobile menu
     ------------------------------------------------------- */

  .site-header__mobile-menu {
    display: none;

    border-top:
      1px solid
      var(--color-border);

    background: var(--color-background);
  }


  .site-header__mobile-menu.is-open {
    display: block;
  }


  .site-header__mobile-menu-list {
    padding: 1rem 0;
  }


  .site-header__mobile-link {
    display: block;

    padding: 0.75rem 0;

    font-size: 1rem;
  }


  /* -------------------------------------------------------
     Responsive
     ------------------------------------------------------- */

  @media screen and (max-width: 749px) {

    .site-header__inner {
      min-height: 64px;

      gap: 1rem;
    }


    .site-header__menu-button {
      display: flex;
    }


    .site-header__navigation {
      display: none;
    }


    .site-header__actions {
      gap: 0.75rem;
    }


    .site-header__action-label {
      display: none;
    }

  }

{% endstylesheet %}


{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Navigation menu",
      "default": "main-menu"
    }
  ],
  "presets": [
    {
      "name": "Header"
    }
  ]
}
{% endschema %}