<footer class="site-footer">

  <div class="page-width">

    <div class="site-footer__top">

      <div class="site-footer__brand">

        <a
          href="{{ routes.root_url }}"
          class="site-footer__brand-name"
        >
          {{ shop.name }}
        </a>

        {% if settings.brand_tagline != blank %}
          <p class="site-footer__tagline">
            {{ settings.brand_tagline }}
          </p>
        {% endif %}

      </div>


      <div class="site-footer__social">

        <h2 class="site-footer__heading">
          Follow us
        </h2>

        {% render 'social-icons' %}

      </div>

    </div>


    <div class="site-footer__bottom">

      <p>
        &copy; {{ 'now' | date: '%Y' }}
        {{ shop.name }}.
        All rights reserved.
      </p>

    </div>

  </div>

</footer>


{% stylesheet %}

  .site-footer {
    padding-top: 4rem;
    padding-bottom: 2rem;

    background: var(--color-surface);
    color: var(--color-text);
  }


  .site-footer__top {
    display: grid;

    grid-template-columns:
      2fr
      1fr;

    gap: 4rem;

    padding-bottom: 4rem;
  }


  .site-footer__brand-name {
    display: inline-block;

    margin-bottom: 1rem;

    font-size: 1.25rem;
    font-weight: 700;
  }


  .site-footer__tagline {
    max-width: 360px;

    margin: 0;

    color: var(--color-text-muted);
  }


  .site-footer__heading {
    margin-bottom: 1rem;

    font-size: 0.875rem;
    font-weight: 600;

    text-transform: uppercase;
    letter-spacing: 0.05em;
  }


  .site-footer__bottom {
    padding-top: 2rem;

    border-top:
      1px solid
      var(--color-border);

    color: var(--color-text-muted);

    font-size: 0.8125rem;
  }


  .site-footer__bottom p {
    margin: 0;
  }


  @media screen and (max-width: 749px) {

    .site-footer__top {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

  }

{% endstylesheet %}


{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "text",
      "id": "menu_title",
      "label": "Menu title",
      "default": "Quick links"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Footer menu",
      "default": "footer"
    }
  ],
  "presets": [
    {
      "name": "Footer"
    }
  ]
}
{% endschema %}