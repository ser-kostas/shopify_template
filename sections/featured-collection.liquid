<section class="featured-collection section">

  <div class="page-width">

    <div class="featured-collection__header">

      <div>

        {% if section.settings.eyebrow != blank %}

          <p class="featured-collection__eyebrow">
            {{ section.settings.eyebrow }}
          </p>

        {% endif %}


        {% if section.settings.heading != blank %}

          <h2 class="heading-lg">
            {{ section.settings.heading }}
          </h2>

        {% endif %}

      </div>


      {% if section.settings.collection != blank %}

        <a
          href="{{ section.settings.collection.url }}"
          class="featured-collection__view-all"
        >
          {{ section.settings.button_label }}
        </a>

      {% endif %}

    </div>


    {% if section.settings.collection != blank %}

      <div
        class="product-grid"
        style="
          --desktop-columns: {{ section.settings.columns_desktop }};
        "
      >

        {% for product in section.settings.collection.products
          limit: section.settings.products_to_show
        %}

          {% render 'product-card',
            product: product,
            show_vendor: section.settings.show_vendor
          %}

        {% endfor %}

      </div>

    {% else %}

      <div class="featured-collection__empty">

        <p>
          Select a collection to display products.
        </p>

      </div>

    {% endif %}

  </div>

</section>


{% stylesheet %}

  .featured-collection__header {
    display: flex;

    align-items: flex-end;
    justify-content: space-between;

    gap: 2rem;

    margin-bottom: 2.5rem;
  }


  .featured-collection__eyebrow {
    margin-bottom: 0.5rem;

    color: var(--color-text-muted);

    font-size: 0.8rem;
    font-weight: 600;

    text-transform: uppercase;
    letter-spacing: 0.1em;
  }


  .featured-collection__header .heading-lg {
    margin-bottom: 0;
  }


  .featured-collection__view-all {
    flex-shrink: 0;

    padding-bottom: 0.2rem;

    border-bottom: 1px solid currentColor;

    font-size: 0.875rem;
  }


  .featured-collection__view-all:hover {
    opacity: 0.65;
  }


  .featured-collection .product-grid {
    grid-template-columns:
      repeat(
        var(--desktop-columns, 4),
        minmax(0, 1fr)
      );
  }


  .featured-collection__empty {
    padding: 4rem 2rem;

    background: var(--color-surface);

    text-align: center;

    color: var(--color-text-muted);
  }


  @media screen and (max-width: 990px) {

    .featured-collection .product-grid {
      grid-template-columns:
        repeat(2, minmax(0, 1fr));
    }

  }


  @media screen and (max-width: 749px) {

    .featured-collection__header {
      align-items: flex-start;

      flex-direction: column;
    }


    .featured-collection .product-grid {
      grid-template-columns:
        repeat(2, minmax(0, 1fr));

      gap: 1rem;
    }

  }

{% endstylesheet %}


{% schema %}
{
  "name": "Featured collection",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Shop"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured products"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Desktop columns",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show product vendor",
      "default": false
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Collection link label",
      "default": "View all"
    }
  ],
  "presets": [
    {
      "name": "Featured collection"
    }
  ]
}
{% endschema %}